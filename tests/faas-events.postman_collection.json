        {
          "name": "5.2 Statistika dogodka (organizator)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Najprej se prijavi kot organizator",
                  "const loginReq = {",
                  "  url: pm.collectionVariables.get('baseUrl') + '/auth/login',",
                  "  method: 'POST',",
                  "  header: { 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ email: 'test@example.com', password: 'geslo123' }) }",
                  "};",
                  "pm.sendRequest(loginReq, (err, res) => {",
                  "  if (res && res.json().data) pm.collectionVariables.set('authToken', res.json().data.token);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Vsebuje totalViews', () => pm.expect(res.data.totalViews).to.be.a('number'));",
                  "pm.test('Vsebuje fillRate', () => pm.expect(res.data.fillRate).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}/stats",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}", "stats"]
            }
