{
  "info": {
    "name": "FaaS Events API",
    "_postman_id": "faas-events-collection-v1",
    "description": "Testna kolekcija za FaaS Events - brezstrežniški sistem za upravljanje dogodkov.\n\nZAPOREDJE TESTIRANJA:\n1. Auth - Registracija\n2. Auth - Prijava (shrani token)\n3. Dogodki - CRUD\n4. Registracije - prijava/odpoved\n5. Datoteke - predpodpisani URL\n6. Analitika - sledenje ogledov",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/local", "type": "string" },
    { "key": "authToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "eventId", "value": "", "type": "string" },
    { "key": "registrationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Avtentikacija",
      "item": [
        {
          "name": "1.1 Registracija novega uporabnika",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Vsebuje token', () => pm.expect(res.data.token).to.be.a('string'));",
                  "pm.test('Vsebuje userId', () => pm.expect(res.data.userId).to.be.a('string'));",
                  "if (res.data.token) {",
                  "  pm.collectionVariables.set('authToken', res.data.token);",
                  "  pm.collectionVariables.set('userId', res.data.userId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"geslo123\",\n  \"name\": \"Test Uporabnik\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Prijava (pridobi token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Vsebuje token', () => pm.expect(res.data.token).to.be.a('string'));",
                  "if (res.data.token) {",
                  "  pm.collectionVariables.set('authToken', res.data.token);",
                  "  pm.collectionVariables.set('userId', res.data.userId);",
                  "  console.log('Token shranjen:', res.data.token.substring(0, 30) + '...');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"geslo123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Napačni podatki za prijavo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "const res = pm.response.json();",
                  "pm.test('Vrne napako', () => pm.expect(res.success).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"napacnogeslo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
