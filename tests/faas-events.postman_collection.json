            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Letna konferenca o najnovejših trendih - posodobljeno!\",\n  \"maxCapacity\": 250\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}"]
