                  "const res = pm.response.json();",
                  "pm.test('Pravilni eventId', () => pm.expect(res.data.eventId).to.equal(pm.collectionVariables.get('eventId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/events/{{eventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["events", "{{eventId}}"]
