{
  "name": "faas-events",
  "version": "1.0.0",
  "description": "FaaS Events - Sistem za upravljanje dogodkov z brezstrežniško arhitekturo",
  "main": "index.js",
  "scripts": {
    "deploy": "serverless deploy --stage dev",
    "db:start": "java -Djava.library.path=.dynamodb/DynamoDBLocal_lib -jar .dynamodb/DynamoDBLocal.jar -sharedDb -inMemory -port 8000",
    "db:setup": "node scripts/setup-local.js",
    "offline": "serverless offline start --stage local",
    "start": "bash scripts/start-local.sh",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "aws-sdk": "^2.1450.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "serverless": "^3.38.0",
    "serverless-dynamodb-local": "^0.2.40",
    "serverless-offline": "^13.3.3"
  },
  "keywords": [
    "serverless",
    "faas",
    "aws-lambda",
    "dynamodb",
    "s3",
    "sqs"
  ],
  "author": "",
  "license": "MIT"
}